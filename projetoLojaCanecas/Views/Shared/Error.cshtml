@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="text-center py-5">
    <h1 class="display-5">Ops! Algo deu errado.</h1>
    <p class="text-muted">Não foi possível concluir a operação. Tente novamente em instantes.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Código da requisição: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-caramelo">Voltar para a loja</a>
</div>
