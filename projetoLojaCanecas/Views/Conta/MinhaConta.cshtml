@model Cliente
@{
    ViewData["Title"] = "Meus dados";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Meus dados</h1>

                <form asp-action="MinhaConta" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <partial name="_DadosCliente" model="Model" />

                    <button type="submit" class="btn btn-caramelo">Salvar alterações</button>
                    <a asp-action="AlterarSenha" class="btn btn-outline-cafe">Alterar senha</a>
                    <a asp-controller="Pedidos" asp-action="Index" class="btn btn-secondary">Minhas compras</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
