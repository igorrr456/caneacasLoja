@model LoginViewModel
@{
    Layout = null;   // tela de login nao usa o menu
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Painel da Loja de Canecas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin">
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height:100vh">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h1 class="h3 text-center mb-1">&#9749; Painel da Loja</h1>
                        <p class="text-center text-muted mb-4">Acesso restrito à equipe</p>

                        @if (ViewBag.Erro != null)
                        {
                            <div class="alert alert-danger">@ViewBag.Erro</div>
                        }

                        <form asp-action="Index" method="post">
                            <div class="mb-3">
                                <label asp-for="Login" class="form-label"></label>
                                <input asp-for="Login" class="form-control" autofocus />
                                <span asp-validation-for="Login" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Senha" class="form-label"></label>
                                <input asp-for="Senha" class="form-control" />
                                <span asp-validation-for="Senha" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-caramelo w-100">Entrar</button>
                        </form>

                        <div class="text-center mt-3"><a asp-area="" asp-controller="Home" asp-action="Index" class="small">&larr; Voltar para a loja</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
