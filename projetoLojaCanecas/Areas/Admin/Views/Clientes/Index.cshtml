@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
    int status = ViewBag.Status;
}

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <h1 class="h3 mb-0">Clientes @(status == 0 ? "(excluídos)" : "")</h1>
    <div class="ms-auto d-flex flex-wrap gap-2">
        @if (status == 1)
        {
            <a asp-action="Index" asp-route-status="0" class="btn btn-outline-secondary">Ver excluídos</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Voltar para ativos</a>
        }
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="hidden" name="status" value="@status" />
            <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Nome, e-mail ou CPF" />
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-admin">
            <thead>
                <tr><th>Nome</th><th>E-mail</th><th>CPF</th><th>Cidade</th><th class="text-center">Pedidos</th><th class="text-end">Total comprado</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.Nome<div class="small text-muted">Desde @c.DataCadastro.ToString("dd/MM/yyyy")</div></td>
                        <td>@c.Email</td>
                        <td>@c.Cpf</td>
                        <td>@c.Cidade/@c.Uf</td>
                        <td class="text-center">@c.TotalPedidos</td>
                        <td class="text-end">@c.TotalComprado.ToString("C")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Detalhes" asp-route-id="@c.Id" class="btn btn-sm btn-outline-cafe">Detalhes</a>
                            @if (status == 1)
                            {
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Excluir este cliente? Ele não poderá mais entrar na loja, mas o histórico de pedidos é mantido.');">
                                    <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Reativar" asp-route-id="@c.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">Reativar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nenhum cliente encontrado.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
