@model List<Produto>
@{
    ViewData["Title"] = "Canecas";
    int status = ViewBag.Status;
}

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <h1 class="h3 mb-0">Canecas @(status == 0 ? "(excluídas)" : "")</h1>
    <div class="ms-auto d-flex flex-wrap gap-2">
        @if (status == 1)
        {
            <a asp-action="Cadastrar" class="btn btn-caramelo">Cadastrar nova caneca</a>
            <a asp-action="Index" asp-route-status="0" class="btn btn-outline-secondary">Ver excluídas</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Voltar para ativas</a>
        }
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="hidden" name="status" value="@status" />
            <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Nome, categoria ou cor" />
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-admin">
            <thead>
                <tr>
                    <th></th>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th class="text-end">Preço</th>
                    <th class="text-center">Estoque</th>
                    <th class="text-center">Destaque</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="width:56px"><img src="@p.ImagemUrl" alt="" class="thumb-sm" /></td>
                        <td>@p.Nome<div class="small text-muted">@p.CapacidadeMl ml @(string.IsNullOrEmpty(p.Cor) ? "" : "· " + p.Cor)</div></td>
                        <td>@p.CategoriaNome</td>
                        <td class="text-end text-nowrap">@p.Preco.ToString("C")</td>
                        <td class="text-center">
                            <span class="badge @(p.Estoque == 0 ? "bg-danger" : p.Estoque <= RegrasLoja.EstoqueBaixo ? "bg-warning text-dark" : "bg-success")">@p.Estoque</span>
                        </td>
                        <td class="text-center">@(p.Destaque ? "★" : "")</td>
                        <td class="text-end text-nowrap">
                            @if (status == 1)
                            {
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Editar</a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Deseja realmente excluir esta caneca? Ela sai da loja, mas os pedidos antigos são mantidos.');">
                                    <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Reativar" asp-route-id="@p.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">Reativar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nenhuma caneca encontrada.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
