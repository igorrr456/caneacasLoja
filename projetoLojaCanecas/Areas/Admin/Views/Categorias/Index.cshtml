@model List<Categoria>
@{
    ViewData["Title"] = "Categorias";
    int status = ViewBag.Status;
}

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <h1 class="h3 mb-0">Categorias @(status == 0 ? "(excluídas)" : "")</h1>
    <div class="ms-auto d-flex flex-wrap gap-2">
        @if (status == 1)
        {
            <a asp-action="Cadastrar" class="btn btn-caramelo">Cadastrar nova categoria</a>
            <a asp-action="Index" asp-route-status="0" class="btn btn-outline-secondary">Ver excluídas</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Voltar para ativas</a>
        }
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="hidden" name="status" value="@status" />
            <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Nome" />
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-admin">
            <thead><tr><th>Nome</th><th>Descrição</th><th class="text-center">Canecas ativas</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.Nome</td>
                        <td>@c.Descricao</td>
                        <td class="text-center">@c.TotalProdutos</td>
                        <td class="text-end text-nowrap">
                            @if (status == 1)
                            {
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Editar</a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Deseja realmente excluir esta categoria?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Reativar" asp-route-id="@c.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">Reativar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Nenhuma categoria encontrada.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
